# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets
client_secret*.json
*service-account*.json
worker/node_modules/
worker/.wrangler/
.dev.vars
*adminsdk*.json

# Signing keys (never commit)
android/key.properties
**/*.jks
**/*.keystore

# Local notes / tools
session/
.claude/

# Portal (Next.js)
portal/node_modules/
portal/.next/
portal/.vercel/
portal/.env*.local

# Android / Gradle build output
android/build/
android/app/build/
android/.gradle/
android/.kotlin/
*.apk
*.aab
!portal/public/CampusBell.apk

# Flutter obfuscation symbols (keep a copy locally to decode crash logs)
build/symbols/
